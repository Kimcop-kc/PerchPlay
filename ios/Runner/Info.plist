<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>PerchPlay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PerchPlay</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- ──────── 不声明 SceneManifest ────────
	     Flutter 走 AppDelegate 生命周期；声明了 SceneManifest 却
	     没有对应的 SceneDelegate 类会导致启动即崩溃（iOS 18+ 更严格）。 -->
	<key>LSRequiresIPhoneOS</key>
	<false/>

	<!-- ──────── 硬件要求 ──────── -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ──────── 支持所有方向 ──────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- ──────── iPad 多窗口方向 ──────── -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- ──────── iPad ProMotion 120Hz ──────── -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ──────── Apple Pencil ──────── -->
	<key>PKCanvasInkEnabled</key>
	<true/>

	<!-- ──────── 后台模式 ──────── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>picture-in-picture</string>
	</array>

	<!-- ──────── 局域网访问（NAS 发现 / DLNA 投屏 / 内置媒体服务）───────
	     iOS 14+ 没有这个描述，系统不会弹授权而是直接拒绝局域网访问，
	     NAS 搜索、投屏、投屏用的本地 HTTP 服务会全部静默失败。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>PerchPlay 需要访问局域网以搜索 NAS 设备、投屏到电视，并把本地视频串流给投屏设备</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_webdav._tcp</string>
		<string>_smb._tcp</string>
		<string>_afpovertcp._tcp</string>
		<string>_googlecast._tcp</string>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
	</array>

	<!-- ──────── ATS：允许局域网明文 HTTP ────────
	     内置媒体服务 / WebDAV / DLNA 都是 http://，默认策略会拒。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- ──────── 允许用「文件」App 导入视频 ──────── -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- ──────── 未使用自定义加密（上架必答项）─────── -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ──────── 支持的文件类型 ──────── -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.mpeg-4</string>
				<string>public.avi</string>
				<string>org.matroska.mkv</string>
				<string>com.apple.quicktime-movie</string>
			</array>
		</dict>
	</array>

	<!-- ──────── 隐私描述 ──────── -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PerchPlay 需要访问照片库以播放其中的视频文件</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>PerchPlay 需要访问媒体库以播放视频</string>
	<key>UISupportsTrueScreenSize</key>
	<true/>
</dict>
</plist>